{
  "manifest_version": 3,
  "name": "视频实时翻译字幕",
  "version": "1.0.0",
  "description": "把正在播放的视频实时翻译成中文字幕(英/日译中), 配合本地转写后台使用。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "视频实时翻译"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
